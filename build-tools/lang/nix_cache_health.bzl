def nix_cache_health_shell():
    return (
        "NIX_BIN=\"${VBR_NIX_BIN:-${NIX_BIN:-}}\"; "
        + "if [ -z \"$NIX_BIN\" ] || [ ! -x \"$NIX_BIN\" ]; then "
        + "  if [ -x /nix/var/nix/profiles/default/bin/nix ]; then "
        + "    NIX_BIN=/nix/var/nix/profiles/default/bin/nix; "
        + "  else "
        + "    NIX_BIN_LOOKUP_TMP=\"${TMPDIR:-${TMP:-/tmp}}/vbr-nix-bin.txt\"; "
        + "    if command -v nix > \"$NIX_BIN_LOOKUP_TMP\" 2>/dev/null; then read -r NIX_BIN < \"$NIX_BIN_LOOKUP_TMP\" 2>/dev/null || NIX_BIN=\"\"; else NIX_BIN=\"\"; fi; "
        + "  fi; "
        + "fi; "
        + "if [ -n \"$NIX_BIN\" ] && [ -x \"$NIX_BIN\" ]; then "
        + "  export NIX_BIN; export VBR_NIX_BIN=\"$NIX_BIN\"; "
        + "  NIX_BIN_DIR=\"${NIX_BIN%/*}\"; "
        + "  case \":${PATH:-}:\" in *\":$NIX_BIN_DIR:\"*) ;; *) export PATH=\"$NIX_BIN_DIR:${PATH:-}\" ;; esac; "
        + "fi; "
        + "NIX_CACHE_PROVEN_REQUIRED=\"${VBR_NIX_CACHE_ROLE_REQUIRED:-}\"; NIX_CACHE_PROVEN_OPTIONAL=\"${VBR_NIX_CACHE_ROLE_OPTIONAL:-}\"; NIX_CACHE_PROVEN_POLICY=\"${VBR_NIX_CACHE_ROLE_POLICY:-}\"; NIX_CACHE_PROVEN_BINDING=\"${VBR_NIX_CACHE_ROLE_BINDING:-}\"; "
        + "unset VBR_NIX_CACHE_ROLE_REQUIRED VBR_NIX_CACHE_ROLE_OPTIONAL VBR_NIX_CACHE_ROLE_POLICY VBR_NIX_CACHE_ROLE_BINDING; "
        + "NIX_CACHE_HEALTH_REVIEWED=0; NIX_CACHE_ROLES_PROVEN=0; unset VBR_NIX_CACHE_HEALTH_APPLIED VBR_NIX_CACHE_HEALTH_REVIEWED_CONFIG VBR_NIX_CACHE_HEALTH_REVIEWED_REQUIRED_SUBSTITUTERS VBR_NIX_CACHE_HEALTH_REVIEWED_OPTIONAL_SUBSTITUTERS VBR_NIX_CACHE_HEALTH_REVIEWED_POLICY; "
        + "if [ \"${VBR_NIX_CACHE_POLICY:-auto}\" != \"off\" ] && [ -n \"${NIX_BIN:-}\" ] && [ -x \"$NIX_BIN\" ]; then "
        + "  NIX_CACHE_HEALTH_REVIEWED=1; "
        + "  NIX_CACHE_TMPDIR=\"${TMPDIR:-${TMP:-/tmp}}\"; "
        + "  NIX_CACHE_STATE_DIR=\"`mktemp -d \"$NIX_CACHE_TMPDIR/vbr-nix-cache-health.XXXXXX\"`\"; "
        + "  NIX_CACHE_UNAME_FILE=\"$NIX_CACHE_STATE_DIR/uname.txt\"; "
        + "  NIX_CACHE_UNAME=\"\"; "
        + "  if uname -s > \"$NIX_CACHE_UNAME_FILE\" 2>/dev/null; then if read -r NIX_CACHE_UNAME < \"$NIX_CACHE_UNAME_FILE\" 2>/dev/null; then :; else NIX_CACHE_UNAME=\"\"; fi; else NIX_CACHE_UNAME=\"\"; fi; "
        + "  if [ \"$NIX_CACHE_UNAME\" = \"Darwin\" ]; then case \"$NIX_CACHE_TMPDIR\" in /tmp|/private/tmp) NIX_CACHE_TMPDIR=\"$NIX_CACHE_TMPDIR/viberoots-nix-cache.noindex\" ;; esac; fi; "
        + "  mkdir -p \"$NIX_CACHE_TMPDIR\"; "
        + "  if [ \"$NIX_CACHE_UNAME\" = \"Darwin\" ]; then [ ! -e \"$NIX_CACHE_TMPDIR/.metadata_never_index\" ] && : > \"$NIX_CACHE_TMPDIR/.metadata_never_index\"; fi; "
        + "  NIX_CACHE_CONFIG_PIPE=\"$NIX_CACHE_STATE_DIR/config.pipe\"; mkfifo \"$NIX_CACHE_CONFIG_PIPE\"; "
        + "  \"$NIX_BIN\" config show > \"$NIX_CACHE_CONFIG_PIPE\" 2>/dev/null & NIX_CACHE_CONFIG_PID=\"$!\"; "
        + "  NIX_CACHE_REQUIRED=\"\"; NIX_CACHE_OPTIONAL=\"\"; NIX_CACHE_NETRC=\"\"; "
        + "  while IFS= read -r NIX_CACHE_LINE; do "
        + "    case \"$NIX_CACHE_LINE\" in "
        + "      substituters\\ =*) NIX_CACHE_VALUE=\"${NIX_CACHE_LINE#*=}\"; NIX_CACHE_REQUIRED=\"$NIX_CACHE_REQUIRED $NIX_CACHE_VALUE\" ;; "
        + "      extra-substituters\\ =*) NIX_CACHE_VALUE=\"${NIX_CACHE_LINE#*=}\"; NIX_CACHE_OPTIONAL=\"$NIX_CACHE_OPTIONAL $NIX_CACHE_VALUE\" ;; "
        + "      netrc-file\\ =*) NIX_CACHE_VALUE=\"${NIX_CACHE_LINE#*=}\"; NIX_CACHE_NETRC=\"${NIX_CACHE_VALUE#${NIX_CACHE_VALUE%%[![:space:]]*}}\"; NIX_CACHE_NETRC=\"${NIX_CACHE_NETRC%${NIX_CACHE_NETRC##*[![:space:]]}}\" ;; "
        + "    esac; "
        + "  done < \"$NIX_CACHE_CONFIG_PIPE\"; "
        + "  if ! wait \"$NIX_CACHE_CONFIG_PID\"; then rm -f \"$NIX_CACHE_CONFIG_PIPE\"; echo \"error: nix config show failed during cache health evaluation\" >&2; exit 1; fi; rm -f \"$NIX_CACHE_CONFIG_PIPE\"; "
        + "  if [ -n \"$NIX_CACHE_PROVEN_REQUIRED$NIX_CACHE_PROVEN_OPTIONAL$NIX_CACHE_PROVEN_POLICY$NIX_CACHE_PROVEN_BINDING\" ]; then "
        + "    NIX_CACHE_BIND_NODE=\"${VBR_ARTIFACT_TOOLS_ROOT:-}/bin/node\"; "
        + "    [ -x \"$NIX_CACHE_BIND_NODE\" ] || { echo 'error: proven Nix cache roles require canonical node' >&2; exit 1; }; "
        + "    NIX_CACHE_BINDING_FILE=\"$NIX_CACHE_STATE_DIR/binding.txt\"; "
        + "    printf 'reviewed-cache-roles-v1\\0%s\\0%s\\0%s\\0%s' \"$NIX_CACHE_PROVEN_POLICY\" \"$NIX_CACHE_PROVEN_REQUIRED\" \"$NIX_CACHE_PROVEN_OPTIONAL\" \"${NIX_CONFIG:-}\" | \"$NIX_CACHE_BIND_NODE\" -e 'const {createHash}=require(\"node:crypto\");const b=[];process.stdin.on(\"data\",x=>b.push(x));process.stdin.on(\"end\",()=>{const raw=Buffer.concat(b),p=raw.toString(\"utf8\").split(\"\\0\"),h=x=>createHash(\"sha256\").update(x||\"\").digest(\"hex\").slice(0,16);process.stdout.write([createHash(\"sha256\").update(raw).digest(\"hex\"),h(p[1]),h(p[2]),h(p[3]),h(p[4]),Buffer.byteLength(p[4]||\"\")].join(\"\\t\")+\"\\n\")})' > \"$NIX_CACHE_BINDING_FILE\"; "
        + "    NIX_CACHE_COMPUTED_BINDING=\"\"; IFS=$'\\t' read -r NIX_CACHE_COMPUTED_BINDING NIX_CACHE_POLICY_DIGEST NIX_CACHE_REQUIRED_DIGEST NIX_CACHE_OPTIONAL_DIGEST NIX_CACHE_CONFIG_DIGEST NIX_CACHE_CONFIG_BYTES < \"$NIX_CACHE_BINDING_FILE\" || { echo 'error: failed to bind reviewed Nix cache roles' >&2; exit 1; }; rm -f \"$NIX_CACHE_BINDING_FILE\"; "
        + "    if [ \"$NIX_CACHE_COMPUTED_BINDING\" != \"$NIX_CACHE_PROVEN_BINDING\" ]; then "
        + "      NIX_CACHE_POLICY_MATCH=false; [ \"$NIX_CACHE_POLICY_DIGEST\" != \"${VBR_NIX_CACHE_BOUND_POLICY_DIGEST:-}\" ] || NIX_CACHE_POLICY_MATCH=true; "
        + "      NIX_CACHE_REQUIRED_MATCH=false; [ \"$NIX_CACHE_REQUIRED_DIGEST\" != \"${VBR_NIX_CACHE_BOUND_REQUIRED_DIGEST:-}\" ] || NIX_CACHE_REQUIRED_MATCH=true; "
        + "      NIX_CACHE_OPTIONAL_MATCH=false; [ \"$NIX_CACHE_OPTIONAL_DIGEST\" != \"${VBR_NIX_CACHE_BOUND_OPTIONAL_DIGEST:-}\" ] || NIX_CACHE_OPTIONAL_MATCH=true; "
        + "      NIX_CACHE_CONFIG_MATCH=false; [ \"$NIX_CACHE_CONFIG_DIGEST\" != \"${VBR_NIX_CACHE_BOUND_CONFIG_DIGEST:-}\" ] || NIX_CACHE_CONFIG_MATCH=true; "
        + "      echo \"error: proven Nix cache roles do not match reviewed config bytes {\\\"policyMatch\\\":$NIX_CACHE_POLICY_MATCH,\\\"requiredMatch\\\":$NIX_CACHE_REQUIRED_MATCH,\\\"optionalMatch\\\":$NIX_CACHE_OPTIONAL_MATCH,\\\"configMatch\\\":$NIX_CACHE_CONFIG_MATCH,\\\"boundConfigBytes\\\":${VBR_NIX_CACHE_BOUND_CONFIG_BYTES:-0},\\\"reviewedConfigBytes\\\":${NIX_CACHE_CONFIG_BYTES:-0}}\" >&2; exit 1; "
        + "    fi; "
        + "    if [ \"$NIX_CACHE_PROVEN_POLICY\" != \"${VBR_NIX_CACHE_POLICY:-auto}\" ]; then echo 'error: proven Nix cache role policy does not match active policy' >&2; exit 1; fi; "
        + "    unset VBR_NIX_CACHE_BOUND_POLICY_DIGEST VBR_NIX_CACHE_BOUND_REQUIRED_DIGEST VBR_NIX_CACHE_BOUND_OPTIONAL_DIGEST VBR_NIX_CACHE_BOUND_CONFIG_DIGEST VBR_NIX_CACHE_BOUND_CONFIG_BYTES; "
        + "    NIX_CACHE_REQUIRED=\"$NIX_CACHE_PROVEN_REQUIRED\"; NIX_CACHE_OPTIONAL=\"$NIX_CACHE_PROVEN_OPTIONAL\"; "
        + "    NIX_CACHE_ROLES_PROVEN=1; "
        + "  fi; "
        + "  if [ \"${VBR_ACTION_NETRC_MATERIALIZED:-}\" = \"1\" ] && [ -f \"${VBR_ACTION_NETRC_FILE:-}\" ] && [ -r \"${VBR_ACTION_NETRC_FILE:-}\" ]; then NIX_CACHE_NETRC=\"$VBR_ACTION_NETRC_FILE\"; fi; "
        + "  if [ -n \"$NIX_CACHE_REQUIRED$NIX_CACHE_OPTIONAL\" ]; then "
        + "    NIX_CACHE_AVAILABLE=\"\"; NIX_CACHE_REMOVED=\"\"; NIX_CACHE_REMOVED_IDENTITIES=\"\"; NIX_CACHE_SEEN=\" \"; "
        + "    for NIX_CACHE_SUB in $NIX_CACHE_REQUIRED $NIX_CACHE_OPTIONAL; do "
        + "      case \"$NIX_CACHE_SEEN\" in *\" $NIX_CACHE_SUB \"*) continue ;; esac; "
        + "      NIX_CACHE_SEEN=\"$NIX_CACHE_SEEN$NIX_CACHE_SUB \"; "
        + "      if [ \"$NIX_CACHE_ROLES_PROVEN\" = \"1\" ]; then NIX_CACHE_AVAILABLE=\"$NIX_CACHE_AVAILABLE ${NIX_CACHE_SUB}\"; continue; fi; "
        + "      case \"$NIX_CACHE_SUB\" in "
        + "        http://*|https://*) "
        + "          NIX_CACHE_IDENTITY=\"${NIX_CACHE_SUB%%\\?*}\"; NIX_CACHE_IDENTITY=\"${NIX_CACHE_IDENTITY%%\\#*}\"; NIX_CACHE_SCHEME=\"${NIX_CACHE_IDENTITY%%://*}://\"; NIX_CACHE_LOCATION=\"${NIX_CACHE_IDENTITY#*://}\"; case \"${NIX_CACHE_LOCATION%%/*}\" in *@*) NIX_CACHE_IDENTITY=\"${NIX_CACHE_SCHEME}<redacted>@${NIX_CACHE_LOCATION#*@}\" ;; esac; "
        + "          NIX_CACHE_NOCASEMATCH=0; if shopt -q nocasematch; then NIX_CACHE_NOCASEMATCH=1; else shopt -s nocasematch; fi; if [[ \"${NIX_CACHE_LOCATION%%/*}\" == *@* || \"$NIX_CACHE_SUB\" =~ [?\\&\\#](access[_-]?token|api[_-]?key|apikey|auth|authorization|credential|credentials|password|passwd|secret|sig|signature|token)= || \"$NIX_CACHE_SUB\" =~ [?\\&\\#][^?\\&\\#=]*%[0-9a-f][0-9a-f][^?\\&\\#=]*= ]]; then echo \"error: configured Nix substituter embeds credentials in its URL; use netrc-file authentication: $NIX_CACHE_IDENTITY\" >&2; exit 1; fi; if [ \"$NIX_CACHE_NOCASEMATCH\" = \"0\" ]; then shopt -u nocasematch; fi; unset NIX_CACHE_NOCASEMATCH; "
        + "          case \"$NIX_CACHE_SUB\" in *\\?*) NIX_CACHE_BASE=\"${NIX_CACHE_SUB%%\\?*}\"; NIX_CACHE_QUERY=\"?${NIX_CACHE_SUB#*\\?}\" ;; *) NIX_CACHE_BASE=\"$NIX_CACHE_SUB\"; NIX_CACHE_QUERY=\"\" ;; esac; "
        + "          NIX_CACHE_INFO_URL=\"${NIX_CACHE_BASE%/}/nix-cache-info${NIX_CACHE_QUERY}\"; "
        + "          if command -v curl >/dev/null 2>&1; then "
        + "            if [ -n \"$NIX_CACHE_NETRC\" ] && [ -f \"$NIX_CACHE_NETRC\" ] && [ -r \"$NIX_CACHE_NETRC\" ]; then "
        + "              if curl -fsS --connect-timeout 3 --max-time 5 --netrc-file \"$NIX_CACHE_NETRC\" \"$NIX_CACHE_INFO_URL\" >/dev/null 2>&1; then NIX_CACHE_PROBE_STATUS=0; else NIX_CACHE_PROBE_STATUS=\"$?\"; fi; "
        + "            elif curl -fsS --connect-timeout 3 --max-time 5 \"$NIX_CACHE_INFO_URL\" >/dev/null 2>&1; then NIX_CACHE_PROBE_STATUS=0; else NIX_CACHE_PROBE_STATUS=\"$?\"; fi; "
        + "          else "
        + "            NIX_CACHE_PROBE_STATUS=1; "
        + "          fi; "
        + "          case \"$NIX_CACHE_PROBE_STATUS\" in 0|5|6|7|16|28|35|52|55|56|92) ;; *) if [ \"${VBR_NIX_CACHE_POLICY:-auto}\" = \"auto\" ]; then case \" $NIX_CACHE_OPTIONAL \" in *\" $NIX_CACHE_SUB \"*) case \" $NIX_CACHE_REQUIRED \" in *\" $NIX_CACHE_SUB \"*) ;; *) NIX_CACHE_REMOVED=\"$NIX_CACHE_REMOVED ${NIX_CACHE_SUB}\"; NIX_CACHE_REMOVED_IDENTITIES=\"$NIX_CACHE_REMOVED_IDENTITIES ${NIX_CACHE_IDENTITY}\"; continue ;; esac ;; esac; fi; echo \"error: Nix cache probe rejected non-transport failure for $NIX_CACHE_IDENTITY: curl exit $NIX_CACHE_PROBE_STATUS\" >&2; exit 1 ;; esac; "
        + "          if [ \"$NIX_CACHE_PROBE_STATUS\" = \"0\" ]; then "
        + "            NIX_CACHE_AVAILABLE=\"$NIX_CACHE_AVAILABLE ${NIX_CACHE_SUB}\"; "
        + "          elif [ \"${VBR_NIX_CACHE_POLICY:-auto}\" = \"auto\" ] && case \" $NIX_CACHE_REQUIRED \" in *\" $NIX_CACHE_SUB \"*) true ;; *) false ;; esac; then "
        + "            NIX_CACHE_AVAILABLE=\"$NIX_CACHE_AVAILABLE ${NIX_CACHE_SUB}\"; "
        + "          else "
        + "            NIX_CACHE_REMOVED=\"$NIX_CACHE_REMOVED ${NIX_CACHE_SUB}\"; NIX_CACHE_REMOVED_IDENTITIES=\"$NIX_CACHE_REMOVED_IDENTITIES ${NIX_CACHE_IDENTITY}\"; "
        + "          fi; "
        + "          ;; "
        + "        *) NIX_CACHE_AVAILABLE=\"$NIX_CACHE_AVAILABLE ${NIX_CACHE_SUB}\" ;; "
        + "      esac; "
        + "    done; "
        + "    if [ -n \"$NIX_CACHE_REMOVED\" ]; then "
        + "      if [ \"${VBR_NIX_CACHE_POLICY:-auto}\" = \"strict\" ]; then echo \"error: configured Nix substituter(s) unavailable:$NIX_CACHE_REMOVED_IDENTITIES\" >&2; exit 1; fi; "
        + "      NIX_CACHE_OPTIONAL_KEPT=\"\"; "
        + "      NIX_CACHE_OPTIONAL_KEPT_IDENTITIES=\"\"; "
        + "      for NIX_CACHE_SUB in $NIX_CACHE_OPTIONAL; do case \" $NIX_CACHE_AVAILABLE \" in *\" $NIX_CACHE_SUB \"*) NIX_CACHE_OPTIONAL_KEPT=\"$NIX_CACHE_OPTIONAL_KEPT ${NIX_CACHE_SUB}\"; NIX_CACHE_IDENTITY=\"${NIX_CACHE_SUB%%\\?*}\"; NIX_CACHE_IDENTITY=\"${NIX_CACHE_IDENTITY%%\\#*}\"; NIX_CACHE_SCHEME=\"${NIX_CACHE_IDENTITY%%://*}://\"; NIX_CACHE_LOCATION=\"${NIX_CACHE_IDENTITY#*://}\"; case \"${NIX_CACHE_LOCATION%%/*}\" in *@*) NIX_CACHE_IDENTITY=\"${NIX_CACHE_SCHEME}<redacted>@${NIX_CACHE_LOCATION#*@}\" ;; esac; NIX_CACHE_OPTIONAL_KEPT_IDENTITIES=\"$NIX_CACHE_OPTIONAL_KEPT_IDENTITIES ${NIX_CACHE_IDENTITY}\" ;; esac; done; "
        + "      NIX_CACHE_REQUIRED_KEPT=\"\"; "
        + "      for NIX_CACHE_SUB in $NIX_CACHE_REQUIRED; do case \" $NIX_CACHE_AVAILABLE \" in *\" $NIX_CACHE_SUB \"*) NIX_CACHE_REQUIRED_KEPT=\"$NIX_CACHE_REQUIRED_KEPT ${NIX_CACHE_SUB}\" ;; esac; done; "
        + "      NIX_CACHE_REQUIRED=\"$NIX_CACHE_REQUIRED_KEPT\"; NIX_CACHE_OPTIONAL=\"$NIX_CACHE_OPTIONAL_KEPT\"; "
        + "      NIX_CACHE_RETAINED_FILE=\"$NIX_CACHE_STATE_DIR/retained.txt\"; : > \"$NIX_CACHE_RETAINED_FILE\"; "
        + "      printf '%s\n' \"${NIX_CONFIG:-}\" | while IFS= read -r NIX_CACHE_ENV_LINE; do "
        + "        NIX_CACHE_ENV_KEY=\"${NIX_CACHE_ENV_LINE%%=*}\"; "
        + "        NIX_CACHE_ENV_KEY=\"${NIX_CACHE_ENV_KEY#${NIX_CACHE_ENV_KEY%%[![:space:]]*}}\"; "
        + "        NIX_CACHE_ENV_KEY=\"${NIX_CACHE_ENV_KEY%${NIX_CACHE_ENV_KEY##*[![:space:]]}}\"; "
        + "        case \"$NIX_CACHE_ENV_KEY\" in substituters|extra-substituters|connect-timeout|stalled-download-timeout|fallback) ;; *) printf '%s\n' \"$NIX_CACHE_ENV_LINE\" >> \"$NIX_CACHE_RETAINED_FILE\" ;; esac; "
        + "      done; "
        + "      NIX_CACHE_RETAINED=\"\"; "
        + "      while IFS= read -r NIX_CACHE_RETAINED_LINE; do "
        + "        if [ -n \"$NIX_CACHE_RETAINED\" ]; then NIX_CACHE_RETAINED=\"${NIX_CACHE_RETAINED}\"$'\\n'\"${NIX_CACHE_RETAINED_LINE}\"; else NIX_CACHE_RETAINED=\"$NIX_CACHE_RETAINED_LINE\"; fi; "
        + "      done < \"$NIX_CACHE_RETAINED_FILE\"; "
        + "      if [ -n \"$NIX_CACHE_RETAINED\" ]; then "
        + "        printf -v NIX_CONFIG '%s\nsubstituters =%s\nextra-substituters =%s\nconnect-timeout = 3\nstalled-download-timeout = 10\nfallback = true' \"$NIX_CACHE_RETAINED\" \"$NIX_CACHE_REQUIRED_KEPT\" \"$NIX_CACHE_OPTIONAL_KEPT\"; "
        + "      else "
        + "        printf -v NIX_CONFIG 'substituters =%s\nextra-substituters =%s\nconnect-timeout = 3\nstalled-download-timeout = 10\nfallback = true' \"$NIX_CACHE_REQUIRED_KEPT\" \"$NIX_CACHE_OPTIONAL_KEPT\"; "
        + "      fi; "
        + "      export NIX_CONFIG; "
        + "      echo \"[nix] cache health: disabled unreachable substituter(s):$NIX_CACHE_REMOVED_IDENTITIES\" >&2; "
        + "      echo \"[nix] cache health: using optional substituter(s):${NIX_CACHE_OPTIONAL_KEPT_IDENTITIES:- <none>}\" >&2; "
        + "    fi; "
        + "  fi; "
        + "fi; "
        + "if [ \"$NIX_CACHE_HEALTH_REVIEWED\" = \"1\" ]; then export VBR_NIX_CACHE_HEALTH_APPLIED=1; export VBR_NIX_CACHE_HEALTH_REVIEWED_CONFIG=\"${NIX_CONFIG:-}\"; export VBR_NIX_CACHE_HEALTH_REVIEWED_REQUIRED_SUBSTITUTERS=\"$NIX_CACHE_REQUIRED\" VBR_NIX_CACHE_HEALTH_REVIEWED_OPTIONAL_SUBSTITUTERS=\"$NIX_CACHE_OPTIONAL\" VBR_NIX_CACHE_HEALTH_REVIEWED_POLICY=\"${VBR_NIX_CACHE_POLICY:-auto}\"; rm -rf \"$NIX_CACHE_STATE_DIR\"; fi; "
    )
