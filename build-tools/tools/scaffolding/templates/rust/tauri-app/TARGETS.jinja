{% if include_mobile_release_placeholders %}
load("@prelude//:rules.bzl", "filegroup")
{% endif %}
load("@viberoots//build-tools/cpp:defs.bzl", "nix_cpp_binary")
load("@viberoots//build-tools/node:defs.bzl", "node_asset_stage", "node_webapp")
load("@viberoots//build-tools/rust:defs.bzl", "rust_test", "rust_wasm_library", "tauri_app")
{% if enable_mobile_scaffold_targets and ("ios" in targets) %}
load("@viberoots//build-tools/rust:defs.bzl", "tauri_ios_app")
{% endif %}
{% if enable_mobile_scaffold_targets and ("android" in targets) %}
load("@viberoots//build-tools/rust:defs.bzl", "tauri_android_app")
{% endif %}
{% if not enable_mobile_scaffold_targets and (("ios" in targets) or ("android" in targets)) %}
fail("rust tauri-app mobile scaffold targets are disabled until reviewed mobile builders land")
{% endif %}

node_webapp(
    name = "frontend_raw",
    ts_module_roots = ["frontend/src"],
)

node_asset_stage(
    name = "frontend",
    app = ":frontend_raw",
    assets = [{"src": ":frontend_wasm", "dest": "frontend.wasm"}],
    labels = ["lang:node", "kind:app", "webapp:static"],
    out = "dist",
)

rust_wasm_library(
    name = "frontend_wasm",
    crate = "{{ name }}",
    default_features = False,
    srcs = ["src/lib.rs"],
)

tauri_app(
    name = "{{ name }}",
    capabilities = ["capabilities/default.json"],
    icons = ["icons/icon.png"],
    crate = "{{ name }}",
    frontend_dist = ":frontend",
    resources = [{"src": "help.txt", "dest": "help/help.txt"}],
    sidecar_deps = [{"src": ":{{ name }}-sidecar", "dest": "bin/{{ name }}-sidecar"}],
    srcs = ["build.rs", "src/lib.rs", "src/main.rs"],
    tauri_config = "tauri.conf.json",
    app_windows = ["main"],
)
{% if include_mobile_release_placeholders %}

# Mobile release placeholders are documentation-only until release admission lands.
filegroup(
    name = "{{ name }}_mobile_release_placeholders",
    srcs = [],
    labels = ["tauri-mobile:release-placeholder"],
)
{% endif %}
{% if enable_mobile_scaffold_targets and ("ios" in targets) %}

tauri_ios_app(
    name = "{{ name }}_ios",
    capabilities = ["capabilities/default.json"],
    icons = ["icons/icon.png"],
    crate = "{{ name }}",
    frontend_dist = ":frontend",
    ios_bundle_identifier = "{{ ios_bundle_identifier or tauri_identifier }}",
    ios_deployment_target = "{{ ios_deployment_target }}",
    resources = [{"src": "help.txt", "dest": "help/help.txt"}],
    srcs = ["build.rs", "src/lib.rs", "src/main.rs"],
    tauri_config = "tauri.conf.json",
    app_windows = ["main"],
)
{% endif %}
{% if enable_mobile_scaffold_targets and ("android" in targets) %}

tauri_android_app(
    name = "{{ name }}_android",
    android_compile_sdk = {{ android_compile_sdk }},
    android_min_sdk = {{ android_min_sdk }},
    android_package = "{{ android_package or tauri_identifier }}",
    capabilities = ["capabilities/default.json"],
    icons = ["icons/icon.png"],
    crate = "{{ name }}",
    frontend_dist = ":frontend",
    resources = [{"src": "help.txt", "dest": "help/help.txt"}],
    srcs = ["build.rs", "src/lib.rs", "src/main.rs"],
    tauri_config = "tauri.conf.json",
    app_windows = ["main"],
)
{% endif %}

nix_cpp_binary(
    name = "{{ name }}-sidecar",
    language_standard = "c11",
    labels = ["sidecar:reviewed"],
    srcs = ["sidecar.c"],
    stl = "none",
)

rust_test(
    name = "{{ name }}-test",
    crate = "{{ name }}",
    default_features = False,
    srcs = ["src/lib.rs"],
)
