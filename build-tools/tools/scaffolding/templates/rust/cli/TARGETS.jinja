load("@viberoots//build-tools/rust:defs.bzl", "rust_binary", "rust_test", "rust_wasi_binary", "rust_wasm_library")

rust_binary(
    name = "{{ name }}",
    crate = "{{ name }}",
    srcs = ["src/main.rs"],
)

rust_test(
    name = "{{ name }}-test",
    crate = "{{ name }}",
    srcs = ["src/main.rs"],
)

rust_wasm_library(
    name = "{{ name }}-wasm",
    crate = "{{ name }}",
    srcs = ["src/lib.rs"],
)

rust_wasi_binary(
    name = "{{ name }}-wasi",
    crate = "{{ name }}",
    srcs = ["src/main.rs"],
)
