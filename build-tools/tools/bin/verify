#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
	-h|--help)
		cat <<'EOF'
usage: v [options] [target...]
       verify [options] [target...]

Run workspace verification.

options:
  --coverage
  --console <auto|super|simple>
  --selector <default|project-closure>
  --project <name>
  --projects <name[,name...]>
  --explain-selection
  --seed-mode <auto|always|never>
  -h, --help
EOF
		exit 0
		;;
esac

script_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
. "${script_dir}/artifact-ingress-env.sh"
artifact_ingress_reexec_with_devshell "$0" "$@"
# shellcheck source=/dev/null
. "${script_dir}/cache-health-command-scope.sh" verified-ingress
export VBR_DEVSHELL_USE_GENERATED_AUTHORITY=1
artifact_ingress_clear_selectors

# shellcheck source=/dev/null
. "${script_dir}/devshell.sh"

artifact_ingress_trust_devshell_baseline "${LIVE_ROOT}"
artifact_ingress_refresh_nix_cache_health
artifact_ingress_publish_reviewed_nix_cache_config
artifact_ingress_restore_or_remove_selectors
unset WORKSPACE_ROOT
artifact_ingress_clear_selectors
artifact_ingress_exec "${LIVE_ROOT}" "build-tools/tools/dev/verify.ts" "$@"
