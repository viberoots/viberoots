#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
	-h|--help)
		cat <<'EOF'
usage: u [--upgrade] [--verbose]

Make project dependency and generated metadata consistent after source edits.

options:
  --upgrade  intentionally upgrade supported project dependencies before reconciliation
  --verbose  show each reconciliation step
  -h, --help

After ordinary dependency edits, run:
  u
  i && b && v

Use u --upgrade only when dependency versions should move.
C++ metadata is reconciled. Cargo resolution is offline and uses reviewed Nix-store tools.
Neither mode moves Nix or flake pins.
Use viberoots update when the viberoots pin itself should move.
EOF
		exit 0
		;;
esac

# shellcheck source=/dev/null
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/cache-health-command-scope.sh" standalone
# shellcheck source=/dev/null
unset VBR_DEVSHELL_USE_GENERATED_AUTHORITY
export VBR_DEVSHELL_RECONCILE=1
. "${SCRIPT_DIR}/devshell.sh"

run_ts "../dev/update.ts" "$@"
