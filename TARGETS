# Buck2 targets
load("@viberoots//build-tools/tools/tests:defs.bzl", "auto_zx_tests")
load("@viberoots//build-tools/tools/buck:heavy_fanout_resource.bzl", "heavy_fanout_resource")
load("@prelude//:rules.bzl", "export_file")

# Auto-generate one zx_test per matching test file.
auto_zx_tests(
    root = "build-tools/tools/tests",
    patterns = [
        "**/*.test.ts",
        "e2e-provider-wiring.ts",
    ],
)

heavy_fanout_resource(
    name = "viberoots_heavy_fanout",
    setup = "@viberoots//build-tools/tools/buck:heavy-fanout-resource.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "bootstrap",
    src = "bootstrap",
    visibility = ["PUBLIC"],
)

export_file(
    name = "post-clone",
    src = "post-clone",
    visibility = ["PUBLIC"],
)

export_file(
    name = "flake.lock",
    src = "flake.lock",
    visibility = ["PUBLIC"],
)
